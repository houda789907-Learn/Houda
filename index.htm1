<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رمضان كريم</title>
    <style>
        /* إعدادات الألوان العامة */
        :root {
            --gold: #d4af37;
            --black: #0a0a0a;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: var(--black);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden; /* لمنع التمرير أثناء شاشة الترحيب */
        }

        /* --- شاشة الترحيب (Splash Screen) --- */
        #splash-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: var(--black);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.5s ease;
        }

        .pentagon-container {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* رسم الشكل الخماسي باستخدام CSS clip-path */
        .pentagon {
            position: absolute;
            width: 200px;
            height: 200px;
            background: var(--gold);
            clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);
            opacity: 0.5;
            animation: pulse 2s infinite;
        }

        .pentagon-2 {
            transform: rotate(180deg); /* تداخل الشكلين */
            background: #b8860b;
        }

        .welcome-text {
            position: relative;
            color: var(--gold);
            font-size: 2.5rem;
            font-weight: bold;
            z-index: 10;
            text-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
            animation: scaleUp 1s ease-out;
        }

        /* --- الصفحة الرئيسية --- */
        #main-content {
            display: none; /* مخفية في البداية */
            padding: 20px;
            text-align: center;
        }

        .header-circles {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 50px;
        }

        .circle {
            width: 120px;
            height: 120px;
            border: 2px solid var(--gold);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--gold);
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);
        }

        .circle:hover {
            background-color: var(--gold);
            color: var(--black);
            box-shadow: 0 0 25px var(--gold);
        }

        /* --- الأنميشن --- */
        @keyframes pulse {
            0% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.1); opacity: 0.6; }
            100% { transform: scale(1); opacity: 0.3; }
        }

        @keyframes scaleUp {
            from { transform: scale(0); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body>

    <div id="splash-screen">
        <div class="pentagon-container">
            <div class="pentagon"></div>
            <div class="pentagon pentagon-2"></div>
            <div class="welcome-text">أهلاً رمضان</div>
        </div>
    </div>

    <div id="main-content">
        <div class="header-circles">
            <a href="#" class="circle">الورد اليومي</a>
            <a href="#" class="circle">الأذكار</a>
        </div>
        
        <h2 style="color: var(--gold); margin-top: 100px;">مبارك عليكم الشهر</h2>
    </div>

    <script>
        // إخفاء شاشة الترحيب بعد ثانيتين
        setTimeout(function() {
            const splash = document.getElementById('splash-screen');
            const main = document.getElementById('main-content');
            
            splash.style.opacity = '0';
            setTimeout(() => {
                splash.style.display = 'none';
                main.style.display = 'block';
                document.body.style.overflow = 'auto'; // إعادة التمرير
            }, 500);
        }, 2000); // 2000 مللي ثانية = ثانيتين
    </script>
</body>
</html>
